# =============================================================================
# ORBIT — example configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed. Every value below is a
# placeholder; none of them are safe for any environment reachable from a
# network. Production values belong in a secret manager, not in a file.
#
# Convention: settings read by the ORBIT application are prefixed `ORBIT_`.
# Unprefixed variables configure third-party containers (Postgres, MinIO) and
# are consumed only by docker-compose.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# One of: development | test | production
ORBIT_ENV=development
# One of: DEBUG | INFO | WARNING | ERROR
ORBIT_LOG_LEVEL=INFO
# Human-readable console logs locally; JSON in every deployed environment.
ORBIT_LOG_FORMAT=console
# Metrics are served on their own ports, never the public API port. Loopback by
# default; set ORBIT_METRICS_HOST=0.0.0.0 only inside a container, and never
# route these ports from an ingress. See docs/operations/observability.md.
ORBIT_METRICS_ENABLED=true
ORBIT_METRICS_HOST=127.0.0.1
ORBIT_METRICS_PORT=9100
ORBIT_WORKER_METRICS_PORT=9101
# A statement / request slower than this is logged at WARNING.
ORBIT_DB_SLOW_QUERY_THRESHOLD_MS=500
ORBIT_SLOW_REQUEST_THRESHOLD_MS=2000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=orbit

# The application always talks to Postgres over asyncpg.
ORBIT_DATABASE_URL=postgresql+asyncpg://orbit:change-me-local-only@localhost:5432/orbit
# Separate database used by the integration test suite. It is dropped and
# recreated freely, so it must never point at a database holding real data.
ORBIT_TEST_DATABASE_URL=postgresql+asyncpg://orbit:change-me-local-only@localhost:5432/orbit_test

ORBIT_DB_POOL_SIZE=10
ORBIT_DB_MAX_OVERFLOW=5
ORBIT_DB_POOL_TIMEOUT_SECONDS=10
# Server-side ceiling on one statement, applied to every connection. A
# client-side deadline only stops the waiting coroutine: the query keeps
# running, keeps its locks, and keeps its connection checked out, and a
# handful of those exhaust the pool. Only PostgreSQL cancelling the statement
# returns the resource. The worker's limit is far higher because its
# statements -- re-index batches, recovery sweeps -- legitimately run long.
ORBIT_DB_STATEMENT_TIMEOUT_SECONDS=15
ORBIT_WORKER_DB_STATEMENT_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Redis — Celery broker/result backend and application cache
# -----------------------------------------------------------------------------
ORBIT_REDIS_URL=redis://localhost:6379/0
ORBIT_CELERY_BROKER_URL=redis://localhost:6379/1
ORBIT_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Bounded so an unreachable or wedged Redis cannot occupy a request worker.
# Short on purpose: every command ORBIT issues is a single O(1) operation, so
# one that has not answered in two seconds is not slow, it is broken -- and
# every caller degrades safely (docs/decisions/0024-redis-usage-and-degradation.md).
ORBIT_REDIS_CONNECT_TIMEOUT_SECONDS=2
ORBIT_REDIS_COMMAND_TIMEOUT_SECONDS=2

# Query-vector cache. Holds the embedding of a search query, keyed by
# workspace, embedding space, and the hash of the query text. It caches the
# output of a pure function, so a hit can never be stale the way a cached
# document list can -- and nothing authorization-dependent is cached anywhere
# in ORBIT. Losing Redis makes every query a miss and nothing else.
ORBIT_QUERY_VECTOR_CACHE_ENABLED=true
ORBIT_QUERY_VECTOR_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO locally)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=orbit-local
MINIO_ROOT_PASSWORD=change-me-local-only

# Leave ORBIT_S3_ENDPOINT_URL empty in production to use real AWS S3.
ORBIT_S3_ENDPOINT_URL=http://localhost:9000
ORBIT_S3_REGION=us-east-1
ORBIT_S3_BUCKET=orbit-documents
ORBIT_S3_ACCESS_KEY_ID=orbit-local
ORBIT_S3_SECRET_ACCESS_KEY=change-me-local-only
# MinIO requires path-style addressing; real S3 uses virtual-host style.
ORBIT_S3_FORCE_PATH_STYLE=true
# Bounded so a hung storage endpoint cannot occupy a request worker for the
# lifetime of the request. The read timeout is per socket read, not per
# operation: a large multipart upload is many reads, each of which must
# individually progress, so a healthy 50 MB upload is not capped at 10 s.
ORBIT_S3_CONNECT_TIMEOUT_SECONDS=3
ORBIT_S3_READ_TIMEOUT_SECONDS=10
# Attempts botocore makes internally. Small on purpose: the caller's policy --
# the upload's error path, or the job's durable backoff -- owns retrying.
ORBIT_S3_MAX_ATTEMPTS=2

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Signing key for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this value invalidates every outstanding access token.
ORBIT_SECRET_KEY=REPLACE_ME_WITH_A_64_BYTE_URLSAFE_RANDOM_STRING

# Access tokens are deliberately short-lived; the refresh token carries session
# lifetime and is rotated on every use (see docs/decisions/0003-authentication.md).
ORBIT_ACCESS_TOKEN_TTL_SECONDS=900
ORBIT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Comma-separated. Must be exact origins — wildcards are rejected at startup
# because credentialed CORS requests cannot use them safely.
ORBIT_CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Brute-force protection
#
# Two independent limits guard every credential check: one per account and one
# per client address. Either tripping rejects the request with 429 and a
# `Retry-After` header. Neither is sufficient alone — a per-IP limit is
# defeated by a botnet, a per-account limit by rotating targets.
#
# The counters live in Redis. If Redis is unreachable the limiter fails OPEN
# and logs at ERROR: a Redis outage must not become a total authentication
# outage. See docs/decisions/0017-rate-limiting.md.
# -----------------------------------------------------------------------------
ORBIT_LOGIN_RATE_LIMIT_PER_ACCOUNT=10
ORBIT_LOGIN_RATE_LIMIT_PER_IP=50
ORBIT_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Far tighter, because each accepted request costs an outbound email to an
# address the caller chose. An unmetered endpoint here is a free mail-bombing
# service that arrives with ORBIT's reputation attached.
ORBIT_ACCOUNT_EMAIL_RATE_LIMIT_PER_ACCOUNT=3
ORBIT_ACCOUNT_EMAIL_RATE_LIMIT_PER_IP=10
ORBIT_ACCOUNT_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600

# Bounded per request by ORBIT_MAX_UPLOAD_BYTES below, but an unlimited *rate*
# of even small, valid uploads is still a resource-exhaustion path -- each one
# costs a streaming hash, an S3 write, and a database row.
ORBIT_UPLOAD_RATE_LIMIT_PER_ACCOUNT=60
ORBIT_UPLOAD_RATE_LIMIT_PER_IP=120
ORBIT_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

# Search. Every hybrid query costs a paid embedding request plus a full-text
# scan and an HNSW probe: unmetered, it is the cheapest way to spend the AI
# budget from one valid account. Looser than chat, because a person refining a
# query legitimately issues a burst of searches in a way they never issue a
# burst of questions.
ORBIT_SEARCH_RATE_LIMIT_PER_ACCOUNT=120
ORBIT_SEARCH_RATE_LIMIT_PER_IP=300
ORBIT_SEARCH_RATE_LIMIT_WINDOW_SECONDS=300

# Whether to believe `X-Forwarded-For` when deciding a client address.
#
# The default (false) is the security control, not a convenience. Any
# client can send that header, so trusting it lets an attacker rotate it
# for a fresh per-IP rate-limit key on every request -- defeating the
# limit against exactly the distributed attacker it exists to stop -- and
# write arbitrary addresses into the audit trail.
#
# Turn it on ONLY where a reverse proxy is known to OVERWRITE the header
# rather than append to it. With it off, the socket peer address is used.
ORBIT_TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# Email
#
# There is deliberately NO `fake` provider. A sender that accepts a message and
# does nothing makes a broken password-reset flow look healthy everywhere
# nobody checks an inbox — and the place someone finally does is production,
# during a lockout.
#
#   unconfigured  Default. Every send raises, loudly and visibly.
#   console       Development only. Writes the message to the log so you can
#                 copy the link. REFUSED AT STARTUP IN PRODUCTION, because a
#                 reset link in a log file is a credential in a log file.
#
# `smtp` delivers through any relay; the `EmailSender` port keeps that out of the reset flow.
# See docs/decisions/0018-account-lifecycle.md.
# -----------------------------------------------------------------------------
# One of: unconfigured | console | smtp
ORBIT_EMAIL_PROVIDER=console
ORBIT_EMAIL_FROM_ADDRESS=no-reply@orbit.local
# For real delivery: ORBIT_EMAIL_PROVIDER=smtp, then (Gmail needs an app password):
# ORBIT_SMTP_HOST=smtp.gmail.com
# ORBIT_SMTP_PORT=587
# ORBIT_SMTP_USERNAME=
# ORBIT_SMTP_PASSWORD=

# One-time links point at the FRONTEND, which posts the token back to the API.
# The token therefore never appears in an API URL that a proxy or access log
# would record. `{token}` is required and checked at startup; production
# additionally requires https.
ORBIT_PASSWORD_RESET_URL_TEMPLATE=http://localhost:3000/auth/reset-password?token={token}
ORBIT_EMAIL_VERIFICATION_URL_TEMPLATE=http://localhost:3000/auth/verify-email?token={token}

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# 50 MiB. Enforced by the application in addition to any reverse-proxy limit;
# the proxy limit alone is not a security control.
ORBIT_MAX_UPLOAD_BYTES=52428800

# -----------------------------------------------------------------------------
# Document processing (see docs/operations/worker.md)
# -----------------------------------------------------------------------------
# Attempts per processing run; only transient failures (outages, a dead worker)
# consume them. A corrupt file fails on the first attempt.
ORBIT_PROCESSING_MAX_ATTEMPTS=5
ORBIT_PROCESSING_RETRY_BASE_SECONDS=15
ORBIT_PROCESSING_RETRY_MAX_SECONDS=900
# A running job not renewed for this long is presumed abandoned by a dead worker.
# Must exceed ORBIT_PROCESSING_TASK_TIME_LIMIT_SECONDS in production.
ORBIT_PROCESSING_LEASE_SECONDS=960
ORBIT_PROCESSING_REDELIVERY_GRACE_SECONDS=600
ORBIT_PROCESSING_RECOVERY_INTERVAL_SECONDS=60
ORBIT_PROCESSING_TASK_TIME_LIMIT_SECONDS=900
ORBIT_PROCESSING_TASK_SOFT_TIME_LIMIT_SECONDS=840

# -----------------------------------------------------------------------------
# AI providers
#
# `fake` is a deterministic, offline provider used by the test suite and by
# local development without credentials. The application is fully functional
# under `fake`; only answer quality differs.
# -----------------------------------------------------------------------------
# One of: fake | openai
ORBIT_AI_PROVIDER=fake

# Required when ORBIT_AI_PROVIDER=openai; nothing below is defaulted in code.
# "openai" means the OpenAI HTTP API, not the company: any compatible endpoint
# works, and the key is simply that endpoint's key.
ORBIT_OPENAI_API_KEY=
# Any OpenAI-compatible /embeddings endpoint (a proxy or gateway works too).
ORBIT_OPENAI_BASE_URL=https://api.openai.com/v1
#
# Google Gemini, through its OpenAI-compatible endpoint (a Google AI Studio key):
#   ORBIT_AI_PROVIDER=openai
#   ORBIT_OPENAI_API_KEY=<your Gemini API key>
#   ORBIT_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   ORBIT_EMBEDDING_MODEL=gemini-embedding-001      # returns 1536 dims on request
#   ORBIT_LLM_MODEL=gemini-3.8-flash
#   ORBIT_LLM_REASONING_EFFORT=low                  # else thinking eats the answer budget
#   ORBIT_ANSWER_MAX_TOKENS=1600
#   # Free tier: 1,000 embedded texts PER DAY per model, and rejected requests
#   # count too -- so small batches, and stop rather than retry once it is spent.
#   ORBIT_EMBEDDING_BATCH_SIZE=40
#   ORBIT_EMBEDDING_MAX_RETRIES=2
# Switching models re-embeds everything: `npm run worker:reindex`.
# Ignored by `fake`, which records its own model id so fake vectors are never
# mistaken for real ones.
ORBIT_EMBEDDING_MODEL=text-embedding-3-small
# REQUIRED. Must match the width of the pgvector column (migration 0001: 1536).
# It is schema, not a knob: a different width is a migration, and a mismatch is
# refused (readiness probe down, worker will not embed). See
# docs/database/embeddings.md before changing this or the model.
ORBIT_EMBEDDING_DIMENSIONS=1536
# Request shaping and retries. Defaults suit text-embedding-3-small.
ORBIT_EMBEDDING_BATCH_SIZE=96
ORBIT_EMBEDDING_MAX_BATCH_TOKENS=100000
ORBIT_EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
ORBIT_EMBEDDING_MAX_RETRIES=3
ORBIT_EMBEDDING_RETRY_BASE_SECONDS=1
ORBIT_EMBEDDING_RETRY_MAX_WAIT_SECONDS=20
ORBIT_EMBEDDING_REINDEX_BATCH_SIZE=500
# HNSW candidate list for dense search; see docs/benchmarks/vector-search.md.
ORBIT_VECTOR_SEARCH_EF_SEARCH=100
# Hybrid search (ADR-0021): candidates per retriever before fusion, and how
# query terms combine in full-text search (any = OR, all = AND).
ORBIT_SEARCH_CANDIDATES_PER_RETRIEVER=50
ORBIT_SEARCH_LEXICAL_MATCH=any

# Grounded question answering (ADR-0022). The chat model; ignored by `fake`,
# which answers as orbit-fake-llm-v1 from the retrieved sources alone.
ORBIT_LLM_MODEL=gpt-4o-mini
# Declared, not discovered: the context budget is computed from it.
ORBIT_LLM_CONTEXT_WINDOW=128000
# For reasoning ("thinking") models only: none | minimal | low | medium | high,
# sent as `reasoning_effort`. Leave unset for gpt-4o-mini, which rejects it.
# ORBIT_LLM_REASONING_EFFORT=
# Per request / between streamed chunks; retries are short because a person
# is waiting, and a stream is only retried before its first token.
ORBIT_LLM_REQUEST_TIMEOUT_SECONDS=30
ORBIT_LLM_MAX_RETRIES=2
ORBIT_LLM_RETRY_BASE_SECONDS=0.5
ORBIT_LLM_RETRY_MAX_WAIT_SECONDS=4
ORBIT_LLM_CIRCUIT_FAILURE_THRESHOLD=5
ORBIT_LLM_CIRCUIT_RESET_SECONDS=30
ORBIT_ANSWER_TEMPERATURE=0.1
ORBIT_ANSWER_MAX_TOKENS=800
# Ceiling on retrieved text per prompt. Whole documents are never sent.
ORBIT_ANSWER_MAX_CONTEXT_TOKENS=6000
ORBIT_ANSWER_RETRIEVAL_TOP_K=12
ORBIT_ANSWER_RERANK_TOP_K=8
ORBIT_ANSWER_MAX_SOURCES=8
ORBIT_ANSWER_HISTORY_MESSAGES=6
ORBIT_ANSWER_MAX_HISTORY_TOKENS=1500
ORBIT_ANSWER_GENERATION_TIMEOUT_SECONDS=60
# Every question costs a retrieval and a model call.
ORBIT_CHAT_RATE_LIMIT_PER_ACCOUNT=30
ORBIT_CHAT_RATE_LIMIT_PER_IP=120
ORBIT_CHAT_RATE_LIMIT_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the browser bundle. Never place a
# secret behind this prefix.
#
# ORBIT is served from a SINGLE ORIGIN (ADR-0009): the browser never talks to a
# different host than the one that served the page. In development, Next.js
# rewrites proxy /api/* to the backend; in production a reverse proxy does.
# An absolute API origin here would break the HttpOnly auth cookies.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin that the Next.js dev-server rewrite proxies to. Development
# only — it is never sent to the browser, which is why it is not NEXT_PUBLIC_.
ORBIT_DEV_API_PROXY_TARGET=http://localhost:8000
