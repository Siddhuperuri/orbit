# ---- Secrets: never commit real configuration ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
coverage.xml
htmlcov/

# ---- Node / Next.js ----
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# ---- Playwright ----
/e2e/test-results/
/e2e/playwright-report/
/e2e/.cache/

# ---- Local infrastructure state ----
.docker-data/

# ---- Editors / OS ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# Celery beat's local schedule state (npm run dev:beat)
celerybeat-schedule*
.celerybeat-schedule*

# ---- Test artifacts ----
# The e2e suite's own Next build dir, Playwright's traces/videos/reports, and
# the coverage output. All regenerated by a run; none belongs in history.
.next-e2e/
e2e/.artifacts/
.coverage-html/
coverage/
.scratch/
.scratch_pytest.txt

# Local tool config
.claude/
.serena/
